---
import { bridges, scenes } from '../data/scenes';
---

<section class="scroll-world" id="inicio" data-scroll-world data-scenes={JSON.stringify(scenes)} data-bridges={JSON.stringify(bridges)} aria-label="Recorrido desde el almacén hasta una cocina profesional">
	<div class="world-stage" aria-hidden="true">
		<div class="media-layer"></div>
		<canvas class="bridge-canvas" width="2560" height="1440"></canvas>
		<img class="bridge-fallback" alt="" />
		<div class="world-wash"></div>
	</div>

	<div class="scene-copy-layer">
		{scenes.map((scene, index) => (
			<article class="scene-copy" data-scene-copy={index} id={`escena-${scene.id}`} aria-label={`Escena ${index + 1}: ${scene.label}`}>
				<p class="scene-count">{String(index + 1).padStart(2, '0')} <span>/ 06</span></p>
				<p class="eyebrow">{scene.eyebrow}</p>
				{index === 0 ? <h1>{scene.title}</h1> : <h2>{scene.title}</h2>}
				<p class="scene-body">{scene.body}</p>
			</article>
		))}
	</div>

	<nav class="scene-rail" aria-label="Navegar por las escenas">
		{scenes.map((scene, index) => (
			<button type="button" data-scene-link={index} aria-label={`Ir a la escena ${index + 1}: ${scene.label}`}>
				<span>{scene.label}</span><i></i>
			</button>
		))}
	</nav>

	<div class="scroll-cue" aria-hidden="true"><span>Desliza para descubrir</span><i></i></div>
	<div class="world-progress" role="progressbar" aria-label="Progreso del recorrido" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><i></i></div>
	<p class="media-status" role="status" aria-live="polite"></p>
	<div class="world-track" aria-hidden="true"></div>

	<div class="reduced-scenes">
		{scenes.map((scene, index) => (
			<article class="reduced-scene" id={`reducida-${scene.id}`}>
				<img src={scene.poster} alt={scene.alt} width="2560" height="1440" loading={index === 0 ? 'eager' : 'lazy'} />
				<div><p class="eyebrow">Escena {String(index + 1).padStart(2, '0')} &middot; {scene.eyebrow}</p>
					<h2>{scene.title}</h2>
					<p>{scene.body}</p></div>
			</article>
		))}
	</div>
</section>

<script>
	import { mountScrollWorld } from '../scripts/scroll-world';
	const root = document.querySelector<HTMLElement>('[data-scroll-world]');
	if (root) mountScrollWorld(root);
</script>
